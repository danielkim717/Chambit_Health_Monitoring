# All inference stays on this device.
INFERENCE_PORT=8000
INFERENCE_URL=http://127.0.0.1:8000
ENABLED_MODELS=efficientphys,mtts_can
TORCH_THREADS=2
# INFERENCE_DEVICE=cuda

# Optional compatible chat-completions endpoint. No provider is enabled by default.
# The base URL includes /v1. API keys never appear in browser code.
# REMOTE_LLM_BASE_URL=https://your-provider.example/v1
# REMOTE_LLM_MODEL=your-model
# REMOTE_LLM_API_KEY=

# Example: a separately launched llama.cpp server with a Qwen3-1.7B Q4 GGUF.
# LOCAL_LLM_BASE_URL=http://127.0.0.1:8080/v1
# LOCAL_LLM_MODEL=Qwen3-1.7B
# LOCAL_LLM_API_KEY=

# Optional verified ONNX exports; absolute filesystem paths recommended.
# EFFICIENTPHYS_ONNX=
# MTTS_CAN_ONNX=
